{
  "name": "nexus-ai",
  "productName": "Nexus AI",
  "version": "0.2.5",
  "description": "Private floating desktop assistant that is excluded from supported screen captures.",
  "main": "./out/main/index.js",
  "author": "Nexus AI",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "dev": "npm run build:native && env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && npm run build:native && electron-vite build",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "postinstall": "npm run build:native",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sherpa-onnx-node": "2.0.3",
    "typescript": "^7.0.2",
    "unpdf": "^2.2.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
